<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol>50</defaultcontrol>
  <controls>
    <include>DefaultBackground</include>
    <control type="image">
      <left>0</left><top>0</top><width>100%</width><height>100%</height>
      <texture colordiffuse="30000000">colors/white.png</texture>
    </control>
    <control type="label">
      <left>120</left><top>64</top><width>1450</width><height>66</height>
      <font>font37</font><label>$INFO[Window.Property(AIS.Title)]</label>
      <textcolor>FFFFFFFF</textcolor><shadowcolor>80000000</shadowcolor><aligny>center</aligny>
    </control>
    <control type="label">
      <left>120</left><top>140</top><width>1400</width><height>44</height>
      <font>font25_narrow</font><label>$INFO[Window.Property(AIS.Status)]</label>
      <textcolor>FFCDD5DF</textcolor><aligny>center</aligny>
    </control>
    <control type="button" id="61">
      <left>1570</left><top>74</top><width>230</width><height>56</height>
      <font>font27</font><label>停止扫描</label><textcolor>FFFFFFFF</textcolor>
      <texturefocus colordiffuse="button_focus" border="16">special://home/addons/script.ai.movie.scanner/resources/skins/Default/media/row.png</texturefocus>
      <texturenofocus colordiffuse="40333333" border="16">special://home/addons/script.ai.movie.scanner/resources/skins/Default/media/row.png</texturenofocus>
      <visible>String.IsEqual(Window.Property(AIS.ScanBusy),true)</visible>
      <onleft>50</onleft><onright>50</onright><onup>50</onup><ondown>50</ondown>
    </control>
    <control type="list" id="50">
      <left>120</left><top>216</top><width>1680</width><height>760</height>
      <orientation>vertical</orientation><scrolltime>100</scrolltime>
      <onleft>noop</onleft><onright>noop</onright>
      <onup condition="String.IsEqual(Window.Property(AIS.ScanBusy),true)">61</onup>
      <onup condition="!String.IsEqual(Window.Property(AIS.ScanBusy),true)">noop</onup>
      <ondown>noop</ondown>
      <itemlayout width="1680" height="84">
        <control type="image">
          <left>0</left><top>2</top><width>1680</width><height>78</height>
          <texture colordiffuse="12FFFFFF" border="16">special://home/addons/script.ai.movie.scanner/resources/skins/Default/media/row.png</texture>
        </control>
        <control type="image">
          <left>20</left><top>19</top><width>44</width><height>44</height>
          <texture>$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio>
        </control>
        <control type="label">
          <left>88</left><top>2</top><width>1560</width><height>78</height>
          <font>font27</font><label>$INFO[ListItem.Label]</label>
          <textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
          <visible>String.IsEmpty(ListItem.Label2)</visible>
        </control>
        <control type="label">
          <left>88</left><top>3</top><width>1560</width><height>43</height>
          <font>font27</font><label>$INFO[ListItem.Label]</label>
          <textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
          <visible>!String.IsEmpty(ListItem.Label2)</visible>
        </control>
        <control type="label">
          <left>88</left><top>45</top><width>1560</width><height>28</height>
          <font>font12</font><label>$INFO[ListItem.Label2]</label>
          <textcolor>FFCDD5DF</textcolor><aligny>center</aligny>
          <visible>!String.IsEmpty(ListItem.Label2)</visible>
        </control>
      </itemlayout>
      <focusedlayout width="1680" height="84">
        <control type="image">
          <left>0</left><top>2</top><width>1680</width><height>78</height>
          <texture colordiffuse="button_focus" border="16">special://home/addons/script.ai.movie.scanner/resources/skins/Default/media/row.png</texture>
          <visible>Control.HasFocus(50)</visible>
        </control>
        <control type="image">
          <left>20</left><top>19</top><width>44</width><height>44</height>
          <texture>$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio>
        </control>
        <control type="label">
          <left>88</left><top>2</top><width>1560</width><height>78</height>
          <font>font27</font><label>$INFO[ListItem.Label]</label>
          <textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
          <visible>String.IsEmpty(ListItem.Label2)</visible>
        </control>
        <control type="label">
          <left>88</left><top>3</top><width>1560</width><height>43</height>
          <font>font27</font><label>$INFO[ListItem.Label]</label>
          <textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
          <visible>!String.IsEmpty(ListItem.Label2)</visible>
        </control>
        <control type="label">
          <left>88</left><top>45</top><width>1560</width><height>28</height>
          <font>font12</font><label>$INFO[ListItem.Label2]</label>
          <textcolor>FFCDD5DF</textcolor><aligny>center</aligny>
          <visible>!String.IsEmpty(ListItem.Label2)</visible>
        </control>
      </focusedlayout>
    </control>
  </controls>
</window>
